#. Description of the plugin
#: pushwi.php
msgid "Pushwi web push: installs the widget and sends posts as push notifications from the editor."
msgstr "Web Push da Pushwi: instala o widget e envia posts como notificações push direto do editor."

#. Author of the plugin
#: pushwi.php
msgid "Butiá Labs"
msgstr ""

#: includes/class-api.php:80
msgid "The Pushwi secret API key is not configured."
msgstr "A chave secreta da API da Pushwi não está configurada."

#. translators: %s: error message from the HTTP layer.
#: includes/class-api.php:105
#, php-format
msgid "Could not reach Pushwi: %s"
msgstr "Não foi possível conectar à Pushwi: %s"

#: includes/class-api.php:130
msgid "Pushwi rejected the secret API key (401). Check the key in Settings → Pushwi."
msgstr "A Pushwi recusou a chave secreta da API (401). Confira a chave em Configurações → Pushwi."

#: includes/class-api.php:135
msgid "Pushwi refused the request (403). Make sure you are using a secret key (sk_live_) for this site and that your plan allows it."
msgstr "A Pushwi recusou a requisição (403). Confira se você está usando uma chave secreta (sk_live_) deste site e se o seu plano permite isso."

#: includes/class-api.php:143
msgid "Pushwi rejected the notification:"
msgstr "A Pushwi recusou a notificação:"

#: includes/class-api.php:145
msgid "Too many requests to Pushwi. Wait a minute and try again."
msgstr "Muitas requisições para a Pushwi. Aguarde um minuto e tente de novo."

#. translators: %d: HTTP status code.
#: includes/class-api.php:148
#, php-format
msgid "Unexpected response from Pushwi (HTTP %d)."
msgstr "Resposta inesperada da Pushwi (HTTP %d)."

#: includes/class-campaign.php:48
