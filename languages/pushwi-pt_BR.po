msgid "WordPress: %s"
msgstr "WordPress: %s"

#: includes/class-settings.php:94
msgid "Settings"
msgstr "Configurações"

#: includes/class-settings.php:140
msgid "Site installation"
msgstr "Instalação no site"

#: includes/class-settings.php:147
msgid "Site public ID"
msgstr "ID público do site"

#: includes/class-settings.php:156
#: includes/class-settings.php:335
msgid "Additional data"
msgstr "Dados adicionais"

#: includes/class-settings.php:164
msgid "Publishing from the editor"
msgstr "Publicação pelo editor"

#: includes/class-settings.php:171
msgid "Secret API key"
msgstr "Chave secreta da API"

#: includes/class-settings.php:180
msgid "Post types"
msgstr "Tipos de post"

#: includes/class-settings.php:188
msgid "Default action for new posts"
msgstr "Ação padrão para novos posts"

#: includes/class-settings.php:217
msgid "Invalid public ID. Copy the exact value shown in your Pushwi dashboard under Widget → Snippet (it starts with \"pub_\")."
msgstr "ID público inválido. Copie o valor exato mostrado no painel da Pushwi em Widget → Snippet (começa com \"pub_\")."

#: includes/class-settings.php:248
msgid "Invalid secret API key. Create one in your Pushwi dashboard under Developer → API keys (it starts with \"sk_live_\")."
msgstr "Chave secreta da API inválida. Crie uma no painel da Pushwi em Desenvolvedor → Chaves de API (começa com \"sk_live_\")."

#: includes/class-settings.php:302
msgid "Loads the Pushwi widget on every page and serves the required service worker at /pushwi-sw.js."
msgstr "Carrega o widget da Pushwi em todas as páginas e serve o service worker obrigatório em /pushwi-sw.js."

#: includes/class-settings.php:310
msgid "Optional. With a secret API key, a Pushwi box appears in the post editor to send the post as a push campaign or save it as a draft in Pushwi."
msgstr "Opcional. Com uma chave secreta da API, aparece uma caixa da Pushwi no editor de posts para enviar o post como campanha push ou salvá-lo como rascunho na Pushwi."

#: includes/class-settings.php:324
msgid "Find it in your Pushwi dashboard under Widget → Snippet. This value is public: it is already visible in your site HTML."
msgstr "Fica no painel da Pushwi em Widget → Snippet. Este valor é público: ele já aparece no HTML do seu site."

#: includes/class-settings.php:331
msgid "Categories"
msgstr "Categorias"

#: includes/class-settings.php:332
msgid "Tags"
msgstr "Tags"

#: includes/class-settings.php:350
msgid "Required to target campaigns at \"readers interested in this post's categories and tags\"."
msgstr "Necessário para segmentar campanhas para \"leitores interessados nas categorias e tags do post\"."

#: includes/class-settings.php:367
msgid "Remove the saved key"
msgstr "Remover a chave salva"

#: includes/class-settings.php:373
msgid "Create one in your Pushwi dashboard under Developer → API keys. It is stored in this site's database and only sent to api.pushwi.com. Leave blank to keep the current key."
msgstr "Crie uma no painel da Pushwi em Desenvolvedor → Chaves de API. Ela fica no banco de dados deste site e só é enviada para api.pushwi.com. Deixe em branco para manter a chave atual."

#: includes/class-settings.php:407
msgid "Don't send"
msgstr "Não enviar"

#: includes/class-settings.php:408
msgid "Send notification when published"
msgstr "Enviar notificação ao publicar"

#: includes/class-settings.php:409
msgid "Create a Pushwi draft when published"
msgstr "Criar rascunho na Pushwi ao publicar"

#: includes/class-settings.php:419
msgid "All subscribers"
msgstr "Todos os inscritos"

#: includes/class-settings.php:420
msgid "Subscribers interested in the post's categories and tags"
msgstr "Inscritos interessados nas categorias e tags do post"

#: includes/class-settings.php:471
msgid "Test connection"
msgstr "Testar conexão"

#: includes/class-settings.php:481
msgid "You are not allowed to do this."
msgstr "Você não tem permissão para fazer isso."

#: includes/class-settings.php:512
msgid "Connected to Pushwi. The secret API key is valid."
msgstr "Conectado à Pushwi. A chave secreta da API é válida."

#: includes/class-settings.php:520
msgid "Pushwi connection failed:"
msgstr "Falha na conexão com a Pushwi:"

#: includes/class-settings.php:534
#: includes/class-settings.php:550
msgid "Warning:"
msgstr "Atenção:"

#: includes/class-settings.php:535
msgid "your site uses \"Plain\" permalinks, which prevents Pushwi from serving the service worker (/pushwi-sw.js). The subscription widget will not work until this is changed."
msgstr "seu site usa links permanentes \"Simples\", o que impede a Pushwi de servir o service worker (/pushwi-sw.js). O widget de inscrição não vai funcionar até isso ser alterado."

#: includes/class-settings.php:537
msgid "Choose another structure in Settings → Permalinks"
msgstr "Escolha outra estrutura em Configurações → Links permanentes"

#: includes/class-settings.php:551
msgid "WordPress is installed in a subdirectory. Browsers require the service worker at the root of your domain, so copy the file below to your web server root:"
msgstr "O WordPress está instalado num subdiretório. Os navegadores exigem o service worker na raiz do domínio, então copie o arquivo abaixo para a raiz do seu servidor web:"
